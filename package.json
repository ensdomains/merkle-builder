{
	"name": "@ensdomains/merkle-builder",
	"version": "0.2.0",
	"description": "Rebuild contract storage tries (Ethereum Merkle-Patricia, Linea sparse Merkle) and generate eth_getProof / linea_getProof",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "bun test",
		"fuzz": "while bun test test/storage.test.ts; do :; done",
		"demo": "bun scripts/demo.ts",
		"demo:linea": "bun scripts/linea.ts",
		"demo:memory": "bun scripts/memory.ts",
		"bench:rows": "bun scripts/rows.ts",
		"readme": "bun scripts/readme.ts",
		"prepublishOnly": "bun run check && bun test && bun run build"
	},
	"peerDependencies": {
		"viem": "^2.30.0"
	},
	"devDependencies": {
		"@adraffy/blocksmith": "^0.1.60",
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.5",
		"typescript": "^7.0.2",
		"viem": "^2.58.4"
	},
	"license": "MIT",
	"homepage": "https://github.com/ensdomains/merkle-builder#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ensdomains/merkle-builder.git"
	},
	"bugs": {
		"url": "https://github.com/ensdomains/merkle-builder/issues"
	},
	"keywords": [
		"Ethereum",
		"Solidity",
		"Merkle",
		"Trie",
		"Linea",
		"Poseidon2",
		"eth_getProof",
		"eth_getStorageAt",
		"linea_getProof"
	],
	"dependencies": {
		"@adraffy/keccak": "^1.3.4"
	}
}
