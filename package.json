{
	"name": "@ensdomains/merkle-builder",
	"version": "0.1.0",
	"description": "Low-level Merkle-Patricia storage trie implementation",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc",
		"test": "bun test",
		"fuzz": "while bun test test/storage.test.ts; do :; done",
		"prepublishOnly": "bun run check && bun test && bun run build"
	},
	"peerDependencies": {
		"viem": "^2.30.0"
	},
	"devDependencies": {
		"@adraffy/blocksmith": "^0.1.60",
		"@types/bun": "^1.4.5",
		"typescript": "^7.0.2",
		"viem": "^2.58.4"
	},
	"license": "MIT",
	"homepage": "https://github.com/ensdomains/merkle-builder#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ensdomains/merkle-builder.git"
	},
	"bugs": {
		"url": "https://github.com/ensdomains/merkle-builder/issues"
	},
	"keywords": [
		"Ethereum",
		"Solidity",
		"Merkle",
		"Trie",
		"eth_getProof",
		"eth_getStorageAt"
	],
	"dependencies": {
		"@adraffy/keccak": "^1.3.4"
	}
}
